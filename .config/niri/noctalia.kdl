layout {

    focus-ring {
        active-color   "#fabd2f"
        inactive-color "#282828"
        urgent-color   "#fb4934"
    }

    border {
        active-color   "#fabd2f"
        inactive-color "#282828"
        urgent-color   "#fb4934"
    }


    tab-indicator {
        active-color   "#fabd2f"
        inactive-color "#745202"
        urgent-color   "#fb4934"
    }

    insert-hint {
        color "#fabd2f80"
    }
}

recent-windows {
    highlight {
        active-color "#fabd2f"
        urgent-color "#fb4934"
    }
}
