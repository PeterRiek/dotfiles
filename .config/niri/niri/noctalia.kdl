layout {

    focus-ring {
        active-color   "#fabd2f"
        inactive-color "#282828"
        urgent-color   "#fb4934"
    }

    border {
        active-color   "#fabd2f"
        inactive-color "#282828"
        urgent-color   "#fb4934"
    }

    shadow {
        color "#28282870"
    }

    tab-indicator {
        active-color   "#fabd2f"
        inactive-color "#765300"
        urgent-color   "#fb4934"
    }

    insert-hint {
        color "#fabd2f80"
    }
}

recent-windows {
    highlight {
        active-color "#fabd2f"
        urgent-color "#fb4934"
    }
}
